# Copy to .env and fill in real values. Never commit .env.

# Ports
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Database (Neon Postgres; wired in a later phase)
DATABASE_URL=

# Auth session secret (wired in a later phase)
SESSION_SECRET=

# Cloudinary (wired in a later phase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend -> API
NEXT_PUBLIC_API_URL=http://localhost:4000